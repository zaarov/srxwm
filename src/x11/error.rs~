use std::fmt;

pub type Result<T> = std::result::Result<T, Error>;

#[derive(Debug)]
pub enum Error {
    Connect(x11rb::errors::ConnectError),
    Connection(x11rb::errors::ConnectionError),
    Reply(x11rb::errors::ReplyError),
}

impl fmt::Display for Error {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        match self {
            Self::Connect(err) => {
                write!(f, "X11 connect error: {err}")
            }

            Self::Connection(err) => {
                write!(f, "X11 connection error: {err}")
            }

            Self::Reply(err) => {
                write!(f, "X11 reply error: {err}")
            }
        }
    }
}

impl std::error::Error for Error {
    fn source(&self) -> Option<&(dyn std::error::Error + 'static)> {
        match self {
            Self::Connect(err) => Some(err),
            Self::Connection(err) => Some(err),
            Self::Reply(err) => Some(err),
        }
    }
}

impl From<x11rb::errors::ConnectError> for Error {
    fn from(err: x11rb::errors::ConnectError) -> Self {
        Self::Connect(err)
    }
}

impl From<x11rb::errors::ConnectionError> for Error {
    fn from(err: x11rb::errors::ConnectionError) -> Self {
        Self::Connection(err)
    }
}

impl From<x11rb::errors::ReplyError> for Error {
    fn from(err: x11rb::errors::ReplyError) -> Self {
        Self::Reply(err)
    }
}
