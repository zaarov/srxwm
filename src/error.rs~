use std::fmt::{
    self,
    Formatter,
    Display,
};
use std::panic::Location;
use std::error::Error as StdError;

#[derive(Debug)]
pub struct Error {
    kind: ErrorKind,
    location: &'static Location<'static>,
}

#[derive(Debug)]
pub enum ErrorKind {
    X11(crate::x11::Error),
}

impl Error {
    #[track_caller]
    pub fn new(kind: ErrorKind) -> Self {
        Self {
            kind,
            location: Location::caller(),
        }
    }
}

impl Display for Error {
    fn fmt(&self, f: &mut Formatter<'_>) -> fmt::Result {
        match &self.kind {
            ErrorKind::X11(e) => {
                write!(f, "X11 error: {} (at {})", e, self.location)
            }
        }
    }
}

impl StdError for Error {}

impl From<crate::x11::Error> for Error {
    #[track_caller]
    fn from(err: crate::x11::Error) -> Self {
        Self::new(ErrorKind::X11(err))
    }
}
